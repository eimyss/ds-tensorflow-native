+
+/// The head block a kernel takes: the largest power of two up to 16 that divides h (24 -> 8, 32 -> 16).
+pub fn headBlock(h: usize) usize {
+    if (h % 16 == 0) return 16;
+    if (h % 8 == 0) return 8;
+    if (h % 4 == 0) return 4;
+    if (h % 2 == 0) return 2;
+    return 1;
+}
+
 pub fn pow2(n: usize) usize {
     return std.math.ceilPowerOfTwo(usize, @max(n, 1)) catch unreachable;
 }
