 }
 
+// Comm.sum of `world` ranks' fp32 partials, then `.to(bf16)`: acc = g[0] + g[1] + ... in rank order (each add fp32,
+// as the two-rank kernel), rounded once into bf16. `plane` is the stride between ranks in elements.
+extern "C" __global__ void tf_ds_addn_bf16_kernel(const float* g, int world, uint64_t plane, __nv_bfloat16* output,
+                                                  uint64_t count) {
+    for (uint64_t i = uint64_t(blockIdx.x) * blockDim.x + threadIdx.x; i < count;
+         i += uint64_t(gridDim.x) * blockDim.x) {
+        float acc = g[i];
+        for (int r = 1; r < world; ++r) acc = __fadd_rn(acc, g[uint64_t(r) * plane + i]);
+        output[i] = __float2bfloat16_rn(acc);
+    }
+}
