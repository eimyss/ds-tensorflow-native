# The whole workspace is committed here (sources included); the upstream clones under src/ had their
# .git moved to ~/ds41-tp3-git-backup/ so that they are plain directories. What stays out is what is
# per-host, regenerated by build.sh, or far too large for a repository.

# ---- models / weights: on TrueNAS, model-tp3 is symlinks into it ----
model-tp3/
engram-1017/
*.safetensors
# ... except the kit's vision bias, which is a source file the kit is rebuilt from:
!src/kitrepo/kit/vision/gate_bias_vl.safetensors
*.index.json

# ---- bakes: the per-rank weight caches (tf-dsv41-rank-cache), ~97 GiB each ----
rank-cache/
rank*.index
rank*.err
/*.log

# ---- generated by build.sh ----
# (comments must be on their own line: gitignore has no inline-comment syntax)
# extracted from src/laky/tensorfold/artifacts/tensorfold-kernels.tar.gz
donor-kernels/
# src/kitrepo/kit + donor variants + kit-extra, and the four RoPE tables (544 MB)
kit-tp3/
# built binaries
out/
.zig-global/
**/.zig-cache/
**/zig-out/

# ---- toolchain: Zig 0.17.0 aarch64, fetched and hash-verified (398 MB) ----
tools/zig/

# ---- container images and other exports ----
images/
*.tar
*.img
*.sif

# ---- local backups, python and editor scratch ----
*.bak
__pycache__/
*.pyc
.DS_Store

# local tuning overlay + A/B output
tp3-tune.env
results/
