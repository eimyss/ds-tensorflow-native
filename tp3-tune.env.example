# tp3-tune.env.example — copy to tp3-tune.env (git-ignored) and edit.
#
# tp3-start.sh sources tp3-tune.env before its own defaults, so anything set here
# wins. Every line is optional; delete what you do not use. See docs/TP3-TUNING.md
# for the measurement order and docs/UPSTREAM-INTEGRATION.md for the reasoning.

# --- thermal stability (jayleaton: cap GB10 at 2100-2200 MHz) ------------------
CLOCK_CAP=2100

# --- profile ------------------------------------------------------------------
# CONTEXT=262144
# POOL=1048576
# PARALLEL=4
# ROUND_ROWS=48

# --- draft depth pricing -------------------------------------------------------
# A round's ms PAST its forward. 25 (today's default) is very likely too high for
# three ranks and makes the engine verify fewer drafts than it should.
# Measure it (docs/TP3-TUNING.md), then set.
# DRAFT_MS=12

# --- extra envs for every rank ------------------------------------------------
# Space-separated VAR=value pairs. Start with ONE lever per boot.
EXTRA_ENVS=""
# EXTRA_ENVS="TF_DS_PREFILL_CHUNK=4096"
# EXTRA_ENVS="TF_DS_L2_MOE_MB=512 TF_DS_L2_DN_MB=256"
# EXTRA_ENVS="TF_DS_CONF_CAL=1.0,0.05"
